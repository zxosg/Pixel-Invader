var data 		= newArray(0xff00ff, 0x0000ff, 0x00ff00, 0xff00ff);
var atrWidth 	= 4;
var dif 		= newArray(0,0,0,0);
var c 		= newArray();
mklut();
var dst 		= newArray(c.length/4);
var ddst		= newArray(c.length/4);
var dcnt		= newArray(c.length/4);
var minval 		= 500000;
var mindex 		= 0;

for(i=0; i<data.length; i++) {
	avgdist(data[i]);
	ddst[mindex] = minval;
	dcnt[mindex] = dcnt[mindex]+1;
}
Array.print(dcnt);
Array.print(ddst);

for(i=0; i<dcnt.length; i++) {
	if (dcnt[i] != 0) {
		if (ddst[i]/dcnt[i]<mindex) {
			mindex = i
		}
	}
}
print(mindex)


function avgdist(col) {
minval = 500000;
mindex = 0;
for(j=0; j<c.length; j+=4) {
	for(a=0; a<4; a++) {
		rot = 16;
		difa = (col>>rot&0xff - c[j+a]>>rot&0xff);
		difa *= difa;
		rot = 8;
		difb = (col>>rot&0xff - c[j+a]>>rot&0xff);
		difb *= difb;
		difa += difb;
		rot = 0;
		difb = (col>>rot&0xff - c[j+a]>>rot&0xff);
		difb *= difb;
		difa += difb;
		dif[a] = difa;
	} // endfor a
	dst[j/4] = dif[0]+dif[1]+dif[2]+dif[3];
	if (dst[j/4]<minval) {
		minval = dst[j/4];
		mindex = j/4;
	}
} // endfor j
}


function mklut() {
c = Array.concat(c,0x00007F,0x00007F,0x000000,0x000000)
c = Array.concat(c,0x0000FE,0x00007F,0x00007F,0x000000)
c = Array.concat(c,0x0000FE,0x00007F,0x0000FE,0x00007F)
c = Array.concat(c,0x007FFF,0x007FFF,0x0000FE,0x0000FE)
c = Array.concat(c,0x007F80,0x007F80,0x000000,0x000000)
}

